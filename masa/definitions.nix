# MasaCMS releases (github:MasaCMS/MasaCMS tags), pinned in versions.nix and
# generated by tools/update-masa.sh (see doc/updating.md). Attrs are named
# masa<version with dots as underscores>, e.g. masa7_4_1. `default` is the
# newest one and what `mkTomcatLucee { isMasa = true; }` uses.

{ lib, mkMasa }:

let
  pins = import ./versions.nix;

  attrName = version: "masa${lib.replaceStrings [ "." ] [ "_" ] version}";

  versions = lib.mapAttrs'
    (
      version: pin:
        lib.nameValuePair (attrName version) (mkMasa {
          inherit version;
          inherit (pin) hash;
          patches = map (p: ./patches + "/${p}") pin.patches;
        })
    )
    pins;

  newest = lib.last (lib.sort lib.versionOlder (lib.attrNames pins));
in
versions // { default = versions.${attrName newest}; }
