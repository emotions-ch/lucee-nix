cabal-version: 2.2

name:           lucee-updater
version:        0.1.0.0
synopsis:       Automated Lucee definitions updater for Nix
description:    A pure functional tool to fetch and update Lucee version definitions
author:         Lucee Nix Maintainers
maintainer:     maintainer@example.com
license:        MIT
build-type:     Simple

common shared-properties
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import: shared-properties
  exposed-modules:
    Lucee.Types
    Lucee.Constants
    Lucee.Fetch
    Lucee.Parse
    Lucee.Parse.Common
    Lucee.Parse.Jar
    Lucee.Parse.Lex
    Lucee.Parse.Extension.Url
    Lucee.Parse.Extension.Html
    Lucee.Parse.Extension.Version
    Lucee.Validation
    Lucee.Hash
    Lucee.Nix
    Lucee
  hs-source-dirs: src
  build-depends:
    base >= 4.7,
    text >= 1.2.3.0,
    bytestring >= 0.10.8.0,
    containers >= 0.6.0.0,
    req >= 3.9.0,
    tagsoup >= 0.14.8,
    aeson >= 1.4.0.0,
    attoparsec >= 0.13.2.0,
    typed-process >= 0.2.6.0,
    unliftio >= 0.2.12.0,
    unliftio-core >= 0.2.0.0,
    mtl >= 2.2.2,
    time >= 1.9.3,
    async >= 2.2.6,
    modern-uri >= 0.3.0.0,
    regex-tdfa >= 1.3.1.0

executable lucee-updater
  import: shared-properties
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >= 4.7,
    lucee-updater,
    text,
    unliftio,
    mtl,
    directory
