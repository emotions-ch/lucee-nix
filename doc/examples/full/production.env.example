# Production Environment Configuration for Lucee Container
# Copy this file to production.env and fill in the actual values

# ==============================================================================
# DATABASE CONFIGURATION (Required)
# ==============================================================================

# Database server hostname or IP address
DATABASE_HOST=your-production-db-host.com

# Database server port (typically 1433 for MSSQL)
DATABASE_PORT=1433

# Database authentication
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-secure-db-password

# All other database settings (timeouts, connection limits, etc.) are inherited from development

# ==============================================================================
# JAVA/JVM CONFIGURATION (Optional)
# ==============================================================================

# JVM memory and performance settings
# Adjust based on your container memory limits and traffic expectations
LUCEE_JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.awt.headless=true

# ==============================================================================
# APPLICATION CONFIGURATION (Optional)
# ==============================================================================

# Logging level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Timezone for the application
TZ=Europe/Zurich

# ==============================================================================
# SECURITY CONSIDERATIONS
# ==============================================================================

# - Never commit this file with actual passwords to version control
# - Use container orchestration secrets management in production
# - Consider rotating DATABASE_PASSWORD regularly
# - Ensure DATABASE_HOST is only accessible from application network
